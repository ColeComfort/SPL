context { in: qpit }

% initialize registers
qinit x
qinit out

% prepare Bell pair
x *= F
(x, out) *= CX

% Bell measurement
(in, x) *= CX
in *= F
% in *= F
% in *= F      

% measure in Z basis
meas x       
meas in     

% phase correction
ctrlX x  out
ctrlZ in out

% discard ancillae
disc in
disc x
