// Test: controlling Pauli gates (classical and quantum)
dim 2;

// Pauli Y as a Pauli routine (so it can be controlled)
@Pauli fn Y(t: Qdit) -> Qdit {
    apply Z(t);
    apply X(t);
    return t;
}

// ---------- Classical control (cctrl) ----------

// cctrl of X and Z on the same target
@Linear fn test_cctrl_paulis() -> Qdit {
    qinit t;
    init b0;      // control for X
    init b1;      // control for Z
    cctrl b0: apply X(t);
    cctrl b1: apply Z(t);
    return t;
}

// cctrl of Y on the target
@Linear fn test_cctrl_Y() -> Qdit {
    qinit t = 2;
    init b;
    cctrl b: apply Y(t);
    return t;
}

// ---------- Quantum control (qctrl) ----------

// qctrl of X then Z using the same control qudit prepared to |1>
@Linear fn test_qctrl_paulis() -> Qdit {
    qinit c;
    qinit t;
    apply X(c);             // put control in |1>
    qctrl c: apply X(t);
    qctrl c: apply Z(t);
    return t;
}

// qctrl of Y using the same control qudit prepared to |1>
@Linear fn test_qctrl_Y() -> Qdit {
    qinit c;
    qinit t;
    apply X(c);
    qctrl c: apply Y(t);
    return t;
}

// Driver: print each compiled SPL
fn main() {
    print spl test_cctrl_paulis;
    print spl test_cctrl_Y;
    print spl test_qctrl_paulis;
    print spl test_qctrl_Y;
}

