dim 2;

// Pauli routine so it can be used under classical control
@Pauli fn Ylike(u: Qdit) -> Qdit {
    apply Z(u);
    apply X(u);
    return u;
}

@Nonlinear fn mix_and_control(a: Dit, b: Dit, t: Qdit) -> Qdit {
    // constant 1 for arithmetic-in-logic
    init one = 1;

    // produce a measured classical bit from a fresh qudit
    qinit anc;
    apply X(anc);
    meas anc;                 // anc: Dit

    // nonlinear boolean expressions (lowered via copy/sum/plusone/and)
    let s: Bool = (a + b) != (a * b);       // parity
    let m: Bool = anc;                      // measured bit
    let t1: Bool = (a + one) == b;          // a+1 == b
    let t2: Bool = (not m) and s;           // gated parity
    let t3: Bool = m and t1;                // branch on meas
    let ctrl: Bool = t2 or t3;              // final classical control bit

    // another guard to ensure an IfStmt exists in the AST
    let route: Bool = (a != 0) or (b != 0);

    if route {
        cctrl ctrl: apply Ylike(t);         // controlled @Pauli
    } else {
        cctrl ctrl: apply X(t);             // controlled primitive Pauli
    }

    return t;
}



